# Copy to .env (used by docker compose and `npm run dev`).

# The Telegram application this deployment logs users in through — create one
# at https://my.telegram.org/apps (operator secrets; end users never see them).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Public URL your users/plugins reach this backend at (HTTPS in production).
PUBLIC_BASE_URL=http://localhost:8300

# Encrypts Telegram api_hash values and session strings at rest.
# Generate: openssl rand -base64 32
ENCRYPTION_SECRET=

# Local development outside docker:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/telegram_connector
# PORT=8300
